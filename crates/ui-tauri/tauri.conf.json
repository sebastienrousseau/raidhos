{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RaidhOS",
  "version": "0.0.3",
  "identifier": "org.raidhos.app",
  "build": {
    "frontendDist": "frontend",
    "devUrl": "frontend"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
