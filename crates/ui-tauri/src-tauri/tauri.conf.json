{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RaidhOS",
  "version": "0.0.3",
  "identifier": "org.raidhos.raidhos",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../frontend",
    "devUrl": null
  },
  "app": {
    "windows": [
      {
        "title": "RaidhOS",
        "width": 980,
        "height": 640,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: tauri:; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/icon.png"
    ]
  }
}
